<odoo>
    <record id="ir_mail_server_view_form_gmail" model="ir.ui.view">
        <field name="name">ir.mail_server.view.form.inherit.oauth.link.gmail</field>
        <field name="model">ir.mail_server</field>
        <field name="inherit_id" ref="google_gmail.ir_mail_server_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[button[@name='open_google_gmail_uri']]" position="inside">
                <button type="object" name="action_oauth_link_open" class="btn-link px-0 ms-3"
                    invisible="smtp_authentication != 'gmail'"
                    title="Get a link to send to the owner of this mailbox: they sign in with their own Google account.">
                    <i class="oi" data-icon="share"/>
                    Get a link for the mailbox owner
                </button>
            </xpath>
        </field>
    </record>

    <record id="ir_mail_server_view_form_outlook" model="ir.ui.view">
        <field name="name">ir.mail_server.view.form.inherit.oauth.link.outlook</field>
        <field name="model">ir.mail_server</field>
        <field name="inherit_id" ref="microsoft_outlook.ir_mail_server_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[button[@name='open_microsoft_outlook_uri']]" position="inside">
                <button type="object" name="action_oauth_link_open" class="btn-link px-0 ms-3"
                    invisible="smtp_authentication != 'outlook'"
                    title="Get a link to send to the owner of this mailbox: they sign in with their own Microsoft account.">
                    <i class="oi" data-icon="share"/>
                    Get a link for the mailbox owner
                </button>
            </xpath>
        </field>
    </record>
</odoo>
